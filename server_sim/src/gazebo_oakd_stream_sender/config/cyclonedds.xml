<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>

            <MaxMessageSize>12MB</MaxMessageSize>
            <FragmentSize>1344B</FragmentSize>
            <AllowMulticast>spdp</AllowMulticast>
        </General>
        <Channels>
            <Channel Name="camera" TransportPriority="0">
                <DataBandwidthLimit>180 Mbps</DataBandwidthLimit>
                <AuxiliaryBandwidthLimit>20 Mbps</AuxiliaryBandwidthLimit>
            </Channel>
        </Channels>
        <Internal>
            <SocketReceiveBufferSize min="10MB"/>
            <SocketSendBufferSize min="10MB"/>
        </Internal>
        <Discovery>
            <ParticipantIndex>auto</ParticipantIndex>
        </Discovery>
    </Domain>
</CycloneDDS>
